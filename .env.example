# Copie para .env e preencha. O .env NUNCA vai para o Git.
#   cp .env.example .env

# --- GitHub OAuth App ---
# github.com/settings/developers -> New OAuth App
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# --- Postgres (usado pelo docker-compose e pelo backend) ---
POSTGRES_DB=repomind
POSTGRES_USER=repomind
POSTGRES_PASSWORD=change_me_locally

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Anthropic ---
# Deixe VAZIO para rodar com SPRING_PROFILES_ACTIVE=mock (analise deterministica,
# sem chamada de rede). Preencha apenas se for usar o perfil `anthropic`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Perfil da aplicacao ---
# mock      -> MockAnalyzer, nao chama a API da Anthropic (padrao de desenvolvimento)
# anthropic -> AnthropicAnalyzer, exige ANTHROPIC_API_KEY valida
SPRING_PROFILES_ACTIVE=mock

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:5173
